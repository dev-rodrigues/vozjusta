  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Volume de Perguntas por Outcome (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "vozjusta-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(vozjusta_business_questions_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Distribuição por Tema (período selecionado)",
      "datasource": {
        "type": "prometheus",
        "uid": "vozjusta-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(vozjusta_business_questions_total[$__range])) by (theme)",
          "legendFormat": "{{theme}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "xField": "theme"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Taxa de Fallback (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "vozjusta-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "100 * sum(rate(vozjusta_business_questions_total{outcome=\"fallback\"}[5m])) / clamp_min(sum(rate(vozjusta_business_questions_total[5m])), 0.000001)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
