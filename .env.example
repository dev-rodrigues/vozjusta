# VozJusta (.env)
# Copie para .env e ajuste conforme seu ambiente.
# Este arquivo também funciona como fallback automático quando .env não existe.

VOZJUSTA_DATABASE_URL=postgresql+psycopg://vozjusta:vozjusta@localhost:5432/vozjusta
VOZJUSTA_OLLAMA_BASE_URL=http://localhost:11434
VOZJUSTA_OLLAMA_CHAT_MODEL=llama3.1:8b
VOZJUSTA_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
VOZJUSTA_OLLAMA_TIMEOUT_SECONDS=300
VOZJUSTA_OLLAMA_NUM_PREDICT=220
VOZJUSTA_OLLAMA_KEEP_ALIVE=30m
VOZJUSTA_USE_HOST_OLLAMA=true
VOZJUSTA_BOOTSTRAP_MODELS=true
VOZJUSTA_OLLAMA_DATA_DIR=/Volumes/bucket/dev-rodrigues/vozjusta/.docker-data/ollama
VOZJUSTA_PROMETHEUS_DATA_DIR=/Volumes/bucket/dev-rodrigues/vozjusta/.docker-data/prometheus
VOZJUSTA_GRAFANA_DATA_DIR=/Volumes/bucket/dev-rodrigues/vozjusta/.docker-data/grafana
VOZJUSTA_GRAFANA_ADMIN_USER=admin
VOZJUSTA_GRAFANA_ADMIN_PASSWORD=admin
VOZJUSTA_ADMIN_TOKEN=trocar-token-admin
VOZJUSTA_APP_ENV=development
VOZJUSTA_APP_LOG_LEVEL=INFO
VOZJUSTA_HOST=0.0.0.0
VOZJUSTA_PORT=8000
VOZJUSTA_MINIMUM_SIMILARITY_FOR_ANSWER=0.45
VOZJUSTA_RAG_RETRIEVE_TOP_K=8
VOZJUSTA_RAG_CONTEXT_TOP_K=2
VOZJUSTA_ASK_CACHE_TTL_SECONDS=600
VOZJUSTA_ASK_CACHE_MAX_ITEMS=256
VOZJUSTA_AUTO_INGEST_ON_START=true
VOZJUSTA_INGEST_PATH=knowledge_base/raw
